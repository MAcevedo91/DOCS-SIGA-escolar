  <diagram name="Página-1" id="7hdywJrMQDHaVrSugLkd">
    <mxGraphModel dx="2357" dy="1355" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam componentStyle uml2\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam monochrome true\nskinparam linetype ortho\nskinparam nodesep 30\nskinparam ranksep 40\n\n&#39; ==========================================================\n&#39; PISO 1: PRESENTACIÓN (FRONTEND SPA / PWA - REACT 18)\n&#39; ==========================================================\npackage \&quot;Capa de Presentación (Frontend SPA / PWA)\&quot; as FrontendPkg {\n  [Módulo UI Convivencia e IA\\n(Incidentes, RICE, Mediación)] as UI_Left\n  [Módulo UI Gestión Escolar\\n(Alumnos, Cursos, Promoción)] as UI_Center\n  [Portal Móvil de Familias\\n(Token 72h sin Login)] as UI_Right\n  [Motor de Sincronización PWA\\n(IndexedDB / Service Worker)] as PWAEngine\n  \n  UI_Left -[hidden]right- UI_Center\n  UI_Center -[hidden]right- UI_Right\n  UI_Left ..&gt; PWAEngine : soporte offline\n}\n\n&#39; ==========================================================\n&#39; PISO 2: API GATEWAY Y CONTROL DE SEGURIDAD (EXPRESS 5)\n&#39; ==========================================================\npackage \&quot;Capa de Control y Seguridad (API Gateway - Express 5)\&quot; as GatewayPkg {\n  [Controlador de Convivencia\\n(Rutas /incidentes, /rice)] as Gateway_Left\n  [Controlador Escolar y Auth\\n(JWT, RBAC y Auditoría)] as Gateway_Center\n  [Controlador de Familias\\n(Rutas /citaciones, /tokens)] as Gateway_Right\n  \n  Gateway_Left -[hidden]right- Gateway_Center\n  Gateway_Center -[hidden]right- Gateway_Right\n}\n\n&#39; ==========================================================\n&#39; PISO 3: SERVICIOS DE DOMINIO Y LÓGICA DE NEGOCIO\n&#39; ==========================================================\npackage \&quot;Servicios de Dominio (Lógica de Negocio)\&quot; as DomainPkg {\n\n  package \&quot;Sub-Dominio Convivencia\&quot; as Sub_Left {\n    [Gestor de Incidentes\\n(incidentesService)] as IncidentesSvc\n    [Protocolos RICE\\n(protocolosService)] as ProtocolosSvc\n    [Mediación Escolar\\n(mediacionesService)] as MediacionSvc\n    IncidentesSvc -down-&gt; ProtocolosSvc\n    ProtocolosSvc -down-&gt; MediacionSvc\n  }\n\n  package \&quot;Sub-Dominio Escolar\&quot; as Sub_Center {\n    [Gestión de Estudiantes\\n(estudiantesService - Módulo 11)] as EstudiantesSvc\n    [Cursos y Jefaturas\\n(cursosService)] as CursosSvc\n    [Cierre y Promoción\\n(cierreAnioService)] as CierreSvc\n    [Compilador PDF Oficial\\n(pdfService / PDFKit)] as PdfSvc\n    EstudiantesSvc -down-&gt; CursosSvc\n    CursosSvc -down-&gt; CierreSvc\n    CierreSvc -down-&gt; PdfSvc\n  }\n\n  package \&quot;Sub-Dominio Familias y Redes\&quot; as Sub_Right {\n    [Citaciones Formativas\\n(citacionesService)] as CitacionesSvc\n    [Sociograma y Redes\\n(sociogramaService)] as SociogramaSvc\n    [Notificaciones y Alertas\\n(notificacionesService)] as NotifSvc\n    CitacionesSvc -down-&gt; SociogramaSvc\n    SociogramaSvc -down-&gt; NotifSvc\n  }\n\n  Sub_Left -[hidden]right- Sub_Center\n  Sub_Center -[hidden]right- Sub_Right\n}\n\n&#39; ==========================================================\n&#39; PISO 4: SUBSISTEMAS ESPECIALIZADOS\n&#39; ==========================================================\npackage \&quot;Subsistema IA y Privacidad\&quot; as AIPkg {\n  [Sanitización DLP\\n(Ley N° 19.628)] as DlpSvc\n  [Cliente Gemini Flash\\n(Circuit Breaker)] as GeminiClient\n  DlpSvc -right-&gt; GeminiClient\n}\n\npackage \&quot;Persistencia Relacional (Supabase)\&quot; as PersistencePkg {\n  [Base de Datos PostgreSQL\\n(Row Level Security / RLS)] as PostgresDB\n  [Almacén de Documentos\\n(Storage Buckets / PDFs)] as StorageSvc\n  PostgresDB -right-&gt; StorageSvc\n}\n\npackage \&quot;Procesamiento Asíncrono\&quot; as AsyncPkg {\n  [Cola de Correo y Tareas\\n(emailQueue / Ausentismo)] as JobQueueSvc\n}\n\nAIPkg -[hidden]right- PersistencePkg\nPersistencePkg -[hidden]right- AsyncPkg\n\n&#39; ==========================================================\n&#39; PISO 5: SERVICIOS EXTERNOS Y DESTINATARIOS\n&#39; ==========================================================\npackage \&quot;Nube de Inteligencia Artificial\&quot; as CloudAI {\n  [Google Gemini API\\n(generativelanguage.googleapis.com)] as GeminiAPI\n}\n\npackage \&quot;Servicios Institucionales Externos\&quot; as CloudServices {\n  [Servidor de Correo SMTP\\n(Notificaciones y Colillas)] as SmtpServer\n  [Especialistas de Salud\\n(Neurólogos / Psiquiatras)] as MedicosExternos\n  SmtpServer -[hidden]right- MedicosExternos\n}\n\nCloudAI -[hidden]right- CloudServices\n\n&#39; ==========================================================\n&#39; CONEXIONES VERTICALES PARALELAS (CERO CRUCES DE LÍNEAS)\n&#39; ==========================================================\n\n&#39; --- COLUMNA 1: FLUJO IZQUIERDO (CONVIVENCIA E IA) ---\nUI_Left -down-&gt; Gateway_Left\nGateway_Left -down-&gt; IncidentesSvc\nSub_Left -down-&gt; DlpSvc\nGeminiClient -down-&gt; GeminiAPI\n\n&#39; --- COLUMNA 2: FLUJO CENTRAL (GESTIÓN ESCOLAR Y PERSISTENCIA) ---\nUI_Center -down-&gt; Gateway_Center\nGateway_Center -down-&gt; EstudiantesSvc\nSub_Center -down-&gt; PostgresDB\nPdfSvc -down-&gt; StorageSvc\n\n&#39; --- COLUMNA 3: FLUJO DERECHO (FAMILIAS, COLAS Y NOTIFICACIONES) ---\nUI_Right -down-&gt; Gateway_Right\nGateway_Right -down-&gt; CitacionesSvc\nSub_Right -down-&gt; JobQueueSvc\nJobQueueSvc -down-&gt; SmtpServer\nSub_Right ..&gt; MedicosExternos : entrega perfil clínico\n\n&#39; Anclajes verticales obligatorios\nFrontendPkg -[hidden]down-&gt; GatewayPkg\nGatewayPkg -[hidden]down-&gt; DomainPkg\nDomainPkg -[hidden]down-&gt; PersistencePkg\nPersistencePkg -[hidden]down-&gt; CloudServices\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8ZGo1POYwQJlECZCjBqB-422">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

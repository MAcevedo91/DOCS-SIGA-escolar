        <UserObject label="Controlador de Familias&#xa;(Rutas /citaciones, /tokens)" plantUmlId="n_26" plantUmlBaseStyle="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#F1F1F1;strokeColor=#181818;fontSize=14;whiteSpace=wrap;shadow=0;" plantUmlBaseValue="Controlador de Familias&#xa;(Rutas /citaciones, /tokens)" id="8ZGo1POYwQJlECZCjBqB-449">

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam componentStyle uml2\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam monochrome true\nskinparam linetype ortho\nskinparam nodesep 25\nskinparam ranksep 35\ntop to bottom direction\n&#39; NIVEL 1: CLIENTES Y DISTRIBUCIÓN\npackage \&quot;Zona de Clientes y Distribución Frontend\&quot; as Zone1 {\n  node \&quot;Vercel Edge Network\\n&lt;&lt;cloud&gt;&gt;\\n(CDN Global / Hosting Frontend)\&quot; as VercelNode\n  node \&quot;Estación de Trabajo Escolar\\n&lt;&lt;device&gt;&gt;\\n(PC / Notebook Escuela El Salvador)\&quot; as PCNode\n  node \&quot;Smartphone Apoderados\\n&lt;&lt;device&gt;&gt;\\n(Web Móvil Token 72h)\&quot; as MobileNode\n  VercelNode -[hidden]right- PCNode\n  PCNode -[hidden]right- MobileNode\n}\nPCNode ..&gt; VercelNode : \&quot;HTTPS 443\\n(Descarga SPA)\&quot;\nMobileNode ..&gt; VercelNode : \&quot;HTTPS 443\\n(Descarga Portal)\&quot;\n&#39; NIVEL 2: CÓMPUTO Y CACHÉ\npackage \&quot;Zona de Cómputo Backend y Aceleración\&quot; as Zone2 {\n  node \&quot;Render Cloud Platform\\n&lt;&lt;cloud&gt;&gt;\\n(Web Service Linux Node.js 18 LTS)\\n• Express 5 REST API (PORT $PORT)\\n• WebSockets Server (PORT 3001)\\n• Bull Queue Workers &amp; Cron Jobs\\n• DLP Sanitizer (Ley 19.628) &amp; PDFKit\&quot; as RenderNode\n  node \&quot;Redis Cloud / Upstash\\n&lt;&lt;cloud&gt;&gt;\\n(Puerto 6379 TCP)\\n• L2 Cache (Dashboard &amp; Stats)\\n• Bull Queue Broker\&quot; as RedisNode\n  RenderNode -[hidden]right- RedisNode\n}\n&#39; Conexiones Clientes -&gt; Backend (Directas hacia abajo)\nPCNode --&gt; RenderNode : \&quot;HTTPS 443 (REST API JWT)\\nWSS 3001 (Alertas en Vivo)\&quot;\nMobileNode --&gt; RenderNode : \&quot;HTTPS 443\\n(Token 72h /tokens)\&quot;\nRenderNode --&gt; RedisNode : \&quot;rediss:// 6379\\n(TCP / TLS)\&quot;\n&#39; NIVEL 3: PERSISTENCIA Y SERVICIOS EXTERNOS\npackage \&quot;Zona de Persistencia y Nube Externa\&quot; as Zone3 {\n  node \&quot;Supabase Cloud Platform\\n&lt;&lt;cloud&gt;&gt;\\n(AWS Managed Infrastructure)\\n• PostgreSQL 15 (Multi-Tenant RLS)\\n• Supabase Storage (Evidencias y PDFs)\\n• audit_log (Trazabilidad JSONB)\&quot; as SupabaseNode\n  node \&quot;Google Cloud AI Studio\\n&lt;&lt;cloud&gt;&gt;\\n(Gemini Flash 2.0 API)\\n• Inferencia de Lenguaje Natural\&quot; as GeminiNode\n  node \&quot;Servidor SMTP Institucional\\n&lt;&lt;cloud&gt;&gt;\\n(Puerto 587 STARTTLS)\\n• Despacho Citaciones y Colillas\&quot; as SmtpNode\n  node \&quot;Sentry Cloud Monitoring\\n&lt;&lt;cloud&gt;&gt;\\n(Puerto 443 HTTPS)\\n• Observabilidad y Telemetría\&quot; as SentryNode\n  SupabaseNode -[hidden]right- GeminiNode\n  GeminiNode -[hidden]right- SmtpNode\n  SmtpNode -[hidden]right- SentryNode\n}\n&#39; Conexiones Backend -&gt; Persistencia y Externos (Abanico directo)\nRenderNode --&gt; SupabaseNode : \&quot;HTTPS / TCP 5432 (Pooler RLS)\\nHTTPS 443 (Storage Buckets)\&quot;\nRenderNode --&gt; GeminiNode : \&quot;HTTPS 443\\n(Payload DLP Sanitizado)\&quot;\nRenderNode --&gt; SmtpNode : \&quot;SMTP / STARTTLS 587\\n(Email Worker)\&quot;\nRenderNode --&gt; SentryNode : \&quot;HTTPS 443\\n(DSN Telemetría)\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9wv5-tAd9B3WN9RgmFQx-182">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
